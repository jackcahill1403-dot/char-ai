PORT=3848

# --- OpenRouter: one key per model (recommended) ---
# Model id or-kimi → OPENROUTER_KEY_OR_KIMI
# Model id or-kimi-code → OPENROUTER_KEY_OR_KIMI_CODE
# Model id or-qwen36 → OPENROUTER_KEY_OR_QWEN36
# Model id or-glm → OPENROUTER_KEY_OR_GLM
# Model id or-gpt-oss → OPENROUTER_KEY_OR_GPT_OSS
# Model id or-deepseek-v4 → OPENROUTER_KEY_OR_DEEPSEEK_V4
# Model id or-flash → OPENROUTER_KEY_OR_FLASH
#
# Multiple keys per model (auto-failover):
# OPENROUTER_KEYS_OR_KIMI=sk-or-1,sk-or-2
#
# Global fallback if a model has no dedicated key:
OPENROUTER_API_KEYS=
# OPENROUTER_API_KEY=

# TAVILY_API_KEY=  # optional — richer !search and auto web context

OPENROUTER_APP_TITLE=Atlas

# Render sync — scripts/sync-render-env.js (do not commit real values)
# RENDER_API_KEY=rnd_...
# RENDER_SERVICE_ID=srv_...

# Gemini — alternative
# GEMINI_API_KEY=

# HF — optional
# HF_TOKEN=

# --- Builder (autonomous agent) ---
# Working directory for relative paths + commands. Absolute paths still work anywhere.
# Defaults to the server's folder. Point it at your projects root if you like.
# AGENT_CWD=C:/Users/you/Projects
