# Copy this file to .env and fill in your values.
#
# Primary LLM — Google Gemini 3.5 Flash (free, no credit card)
#   Get a key: https://aistudio.google.com/apikey
#   Free tier: 15 RPM, 1,500 requests/day, 1M-token context.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Fallback LLM — OpenRouter (free, email signup, no credit card)
#   Used automatically when Gemini rate-limits (429) or errors out.
#   Get a key: https://openrouter.ai/  (sign up with any email)
#   Free tier: 20 RPM, 50 requests/day (1,000/day after a one-time $10 credit).
#   Leave FALLBACK_API_KEY blank to disable fallback.
#
#   This is provider-agnostic — to use Cerebras, SambaNova, Mistral, or any
#   other OpenAI-compatible provider instead, just swap the URL + model + key.
FALLBACK_API_KEY=
FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
FALLBACK_API_URL=https://openrouter.ai/api/v1/chat/completions

# Per-user message limits (each successful LLM call counts as one message).
# Resets on a sliding window — oldest timestamp drops off after 1 hour / 24 hours.
# Set to a high number to effectively disable, e.g. RATE_LIMIT_PER_HOUR=999999
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=50

# Render / production: set NODE_ENV=production in the dashboard.
# ENABLE_FACT_GEN=true only if you want background fact generation on the server.
