PORT=3849

# --- OpenRouter keys ---
# Easiest: one shared key works for all four models.
# OPENROUTER_API_KEY=sk-or-...

# Or give each model its own key (overrides the shared one):
# OPENROUTER_KEY_CLAUDE=sk-or-...     # anthropic/claude-3.5-sonnet  — planning & structure
# OPENROUTER_KEY_GEMINI=sk-or-...     # google/gemini-2.0-flash-001  — long-context organising
# OPENROUTER_KEY_DEEPSEEK=sk-or-...   # deepseek/deepseek-r1         — step-by-step reasoning
# OPENROUTER_KEY_GPT4O=sk-or-...      # openai/gpt-4o                — general drafting

# Optional OpenRouter attribution headers
# OPENROUTER_REFERRER=https://your-nexa-url
# OPENROUTER_APP_TITLE=Nexa
